# MBOA STYLE — Modèle de configuration (NE JAMAIS COMMITTER DE VRAIES VALEURS)
# Copier vers `.env` (ignoré par Git) ou exporter ces variables dans l'environnement
# du service Tomcat de production. Voir docs/configuration.md et
# docs/production-readiness.md.

# --- Base de données (OBLIGATOIRE en production) ---
# Exemple : jdbc:mysql://db-prod:3306/mboa_style?useSSL=true&serverTimezone=Africa/Douala
DB_URL=
DB_USER=mboa_app
DB_PASSWORD=

# --- Application ---
APP_ENV=production
APP_BASE_URL=https://mboastyle.cm

# --- Uploads persistants (défaut : ~/mboa-style-uploads) ---
MBOA_UPLOADS_DIR=/var/lib/mboa-style/uploads

# --- Google OAuth (production : créer un client dédié, voir docs) ---
GOOGLE_CLIENT_ID=

# --- Paiements : MANUELS en production (COD + Mobile Money vérifié, Phase 11) ---
# STATUS = NOT CONFIGURED (aucun PSP externe). Ne pas ajouter de clé LIVE ici
# sans procédure Phase 22.
PAYMENT_PROVIDER=MANUAL

# --- PawaPay (Sandbox d'abord, JAMAIS de vrai token ici) ---
# Copier ces 3 lignes dans `.env` (ignoré par Git) puis coller le token SANDBOX.
# Le backend lit PAWAPAY_API_TOKEN via System.getenv() (voir PawaPayConfig).
# Sans token : erreur serveur claire "PawaPay API token is not configured",
# sans jamais afficher la valeur. Pas de token au frontend, ni en base, ni en logs.
PAWAPAY_API_TOKEN=
PAWAPAY_API_URL=https://api.sandbox.pawapay.io
PAWAPAY_DEPOSIT_URL=https://api.sandbox.pawapay.io/v2/deposits
PAWAPAY_ENVIRONMENT=sandbox

# --- Email SMTP (notifications client/vendeur, JAMAIS de mot de passe en code) ---
# Sans SMTP_HOST : les emails restent en file QUEUED (email NOT CONFIGURED).
# SMTP_TLS = starttls (défaut, port 587) | ssl (port 465) | off.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=BAZAAR
SMTP_TLS=starttls

# --- CORS (aucune origine externe par défaut ; frontend servi par Tomcat) ---
CORS_ALLOWED_ORIGINS=

# --- Logs ---
LOG_LEVEL=INFO
